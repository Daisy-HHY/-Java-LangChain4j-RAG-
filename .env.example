# Copy to .env in the repository root. Compose reads this file for interpolation.
# IDEA does NOT load it automatically; see docs/DOCKER_DEVELOPMENT.md.
KGQA_DB_USERNAME=postgres
KGQA_DB_PASSWORD=123456
KGQA_DB_PORT=5432

# Set a real API key locally; never commit it.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Tested chat model for local setup. Change to another enabled model if needed.
# The application fallback MiniMaxAI/MiniMax-M2.5 was disabled by the provider.
SILICONFLOW_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Keep the same secret in Compose and IDEA so cookies survive mode switches.
KGQA_AUTH_TOKEN_SECRET=kgqa-local-development-change-me
KGQA_DEFAULT_ADMIN_USERNAME=admin
KGQA_DEFAULT_ADMIN_PASSWORD=admin123

# Compose resolves relative paths from the repository root.
# These host paths are NOT container paths or IDEA's KGQA_TDB_PATH / UPLOAD_PATH.
KGQA_TDB_HOST_PATH=./.runtime/tdb_drug_new
KGQA_UPLOAD_HOST_PATH=./uploads
# Windows absolute path example: KGQA_TDB_HOST_PATH="E:/My Project/.runtime/tdb_drug_new"

# Enable only if Docker Desktop does not detect source file changes.
VITE_USE_POLLING=false
